# Normalize text files and keep shell scripts usable on Linux/macOS.
* text=auto
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.toml text eol=lf
*.gradle text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets and Gradle wrapper
*.jar binary
*.aar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.mp3 binary
*.wav binary
*.ogg binary
